---
import { Image } from 'astro:assets';
import { formatPrice } from '../lib/catalog';
import type { CatalogItem } from '../types';

export interface Props {
  item: CatalogItem;
  /** Heading rank for the item name (listing pages usually nest under page H1). */
  headingLevel?: 'h2' | 'h3';
}

const { item, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="flex flex-col p-5 bg-white border border-slate-200 rounded-2xl hover:border-emerald-500/40 hover:shadow-md transition-all duration-200">
  {item.image &&
    (typeof item.image.src === 'string' ? (
      <img
        src={item.image.src}
        alt={item.image.alt}
        width={item.image.width}
        height={item.image.height}
        loading="lazy"
        decoding="async"
        class="w-full aspect-[4/3] object-cover rounded-xl mb-4"
      />
    ) : (
      <Image
        src={item.image.src}
        alt={item.image.alt}
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 400px"
        loading="lazy"
        class="w-full aspect-[4/3] object-cover rounded-xl mb-4"
      />
    ))}

  <Heading class="text-lg font-bold text-slate-900 mb-1">
    <a href={item.url} class="hover:text-emerald-600 transition-colors">
      {item.name}
    </a>
  </Heading>

  {item.description && <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">{item.description}</p>}

  <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-2 text-sm">
    {item.category && (
      <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-700 rounded-full">
        {item.category}
      </span>
    )}
    {item.price && (
      <span class="font-semibold text-slate-900">{formatPrice(item.price)}</span>
    )}
    {item.available === true && (
      <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-emerald-50 text-emerald-800 rounded-full border border-emerald-200">
        Tersedia
      </span>
    )}
    {item.available === false && (
      <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-500 rounded-full">
        Tidak tersedia
      </span>
    )}
  </div>
</article>
