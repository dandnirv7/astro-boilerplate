---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { siteConfig } from '../../../config/site';
import { CatalogGrid, entryToCatalogItem, sortItems } from '../../../capabilities/catalog/index.js';
import { groupByCategory } from '../../../capabilities/search/index.js';
import { resolveCanonical } from '../../../lib/seo';
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
  buildBreadcrumbSchema,
} from '../../../lib/schema';

const BASE_PATH = '/katalog/';
const CATEGORY_BASE = `${BASE_PATH}kategori/`;

export async function getStaticPaths() {
  // Literals inline: getStaticPaths must not depend on module-scope bindings.
  const items = (await getCollection('catalog'))
    .filter((e) => !e.data.draft)
    .map((e) => entryToCatalogItem(e, '/katalog/'));
  return groupByCategory(items, '/katalog/kategori/').map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = sortItems(category.items);
const canonicalUrl = resolveCanonical(category.url);

const pageTitle = `Kategori: ${category.name}`;
const pageDescription = `Daftar item katalog dalam kategori ${category.name}.`;

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog', url: BASE_PATH },
  { name: category.name, url: category.url },
];

const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, pageTitle, pageDescription, {
    breadcrumbId: `${canonicalUrl}#breadcrumb`,
  }),
  buildBreadcrumbSchema(breadcrumbItems, canonicalUrl),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  image={siteConfig.ogDefault}
  graph={graph}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbItems} class="mb-6" />

    <div class="border-b border-slate-200 pb-8 mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {pageTitle}
      </h1>
      <p class="mt-3 text-lg text-slate-600 max-w-3xl">
        {pageDescription}
      </p>
    </div>

    <CatalogGrid items={items} columns={3} />

    <nav aria-label="Navigasi katalog" class="mt-10 pt-6 border-t border-slate-200">
      <a href={BASE_PATH} class="text-sm font-semibold text-emerald-600 hover:text-emerald-700">
        <span aria-hidden="true">←</span> Kembali ke Katalog
      </a>
    </nav>
  </div>
</BaseLayout>
