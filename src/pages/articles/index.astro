---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { resolveCanonical } from '../../lib/seo';
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const pageTitle = 'Artikel & Wawasan Strategis';
const pageDescription = 'Kumpulan artikel, analisis mendalam, dan panduan objektif untuk membantu pengambilan keputusan yang tepat.';
const canonicalUrl = resolveCanonical('/articles');

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Artikel', url: '/articles/' },
];

const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, pageTitle, pageDescription, {
    breadcrumbId: `${canonicalUrl}#breadcrumb`,
  }),
  buildBreadcrumbSchema(breadcrumbItems, canonicalUrl),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  graph={graph}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbItems} class="mb-6" />

    <div class="border-b border-slate-200 pb-8 mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {pageTitle}
      </h1>
      <p class="mt-3 text-lg text-slate-600 max-w-3xl">
        {pageDescription}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {articles.map((article) => {
        const cleanId = article.id.replace(/\.[^/.]+$/, '');
        const articleUrl = `/articles/${cleanId}/`;
        const formattedDate = article.data.publishDate.toLocaleDateString('id-ID', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });

        return (
          <article class="flex flex-col justify-between p-6 bg-white border border-slate-200 rounded-2xl hover:border-emerald-500/40 hover:shadow-md transition-all duration-200">
            <div>
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                <time datetime={article.data.publishDate.toISOString()}>{formattedDate}</time>
                <span>•</span>
                <span>{article.data.author}</span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 group-hover:text-emerald-600 transition-colors mb-2">
                <a href={articleUrl} class="hover:text-emerald-600">
                  {article.data.title}
                </a>
              </h2>

              <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">
                {article.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {article.data.tags.map((tag) => (
                  <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-700 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={articleUrl}
                class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 flex items-center gap-1"
              >
                <span>Baca Selengkapnya</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
