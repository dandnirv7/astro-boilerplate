---
import { getCollection, render } from 'astro:content';
import type { BlogPosting } from 'schema-dts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { WaButton } from '../../capabilities/lead/index.js';
import { siteConfig } from '../../config/site';
import { resolveCanonical } from '../../lib/seo';
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
  buildBreadcrumbSchema,
  makeId,
} from '../../lib/schema';
import { stripExtension } from '../../lib/content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((a) => !a.data.draft);
  return articles.map((article) => {
    const slug = stripExtension(article.id);
    return {
      params: { slug },
      props: { article },
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);

const cleanSlug = stripExtension(article.id);
const canonicalUrl = resolveCanonical(`/articles/${cleanSlug}`);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Artikel', url: '/articles/' },
  { name: article.data.title, url: `/articles/${cleanSlug}/` },
];

const formattedDate = article.data.publishDate.toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// BlogPosting Schema node
const blogPostingSchema: BlogPosting = {
  '@type': 'BlogPosting',
  '@id': makeId(canonicalUrl, '#article'),
  isPartOf: { '@id': makeId(canonicalUrl, '#webpage') },
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishDate.toISOString(),
  ...(article.data.modifiedDate && { dateModified: article.data.modifiedDate.toISOString() }),
  author: {
    '@type': 'Person',
    name: article.data.author,
  },
  publisher: {
    '@id': makeId(siteConfig.url, '#org'),
  },
  inLanguage: siteConfig.locale,
  mainEntityOfPage: canonicalUrl,
  keywords: article.data.tags.join(', '),
};

const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, article.data.title, article.data.description, {
    breadcrumbId: `${canonicalUrl}#breadcrumb`,
    datePublished: article.data.publishDate.toISOString(),
    ...(article.data.modifiedDate && { dateModified: article.data.modifiedDate.toISOString() }),
  }),
  buildBreadcrumbSchema(breadcrumbItems, canonicalUrl),
  blogPostingSchema,
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={canonicalUrl}
  graph={graph}
  og={{
    type: 'article',
    title: article.data.title,
    description: article.data.description,
  }}
  article={{
    publishedTime: article.data.publishDate.toISOString(),
    modifiedTime: article.data.modifiedDate?.toISOString(),
    authors: [article.data.author],
    tags: article.data.tags,
  }}
>
  <!-- Explicit LEAD composition: header CTA + floating button (opt-in per page) -->
  <Header slot="header">
    <div slot="cta" class="flex items-center gap-4">
      <WaButton text="Konsultasi" variant="inline" class="text-sm px-4 py-2" />
    </div>
  </Header>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <Breadcrumbs items={breadcrumbItems} class="mb-6" />

    <article class="bg-white">
      <header class="mb-8 border-b border-slate-200 pb-8">
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 mb-3">
          <time datetime={article.data.publishDate.toISOString()} class="font-medium text-slate-700">
            {formattedDate}
          </time>
          <span>•</span>
          <span>Ditulis oleh <strong class="font-medium text-slate-900">{article.data.author}</strong></span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
          {article.data.title}
        </h1>

        <p class="mt-4 text-lg sm:text-xl text-slate-600 leading-relaxed">
          {article.data.description}
        </p>

        {article.data.tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {article.data.tags.map((tag) => (
              <span class="inline-block px-3 py-1 text-xs font-semibold bg-emerald-50 text-emerald-800 rounded-full border border-emerald-200">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Markdown body with typography styling -->
      <div class="prose prose-slate lg:prose-lg max-w-none space-y-6 text-slate-700 leading-relaxed">
        <Content />
      </div>

      <!-- Contextual back-link: article detail -> listing (descriptive anchor) -->
      <nav aria-label="Navigasi artikel" class="mt-10 pt-6 border-t border-slate-200">
        <a href="/articles/" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700">
          <span aria-hidden="true">←</span> Kembali ke Artikel &amp; Wawasan
        </a>
      </nav>

      <!-- In-article Lead WA conversion card -->
      <div class="mt-14 p-8 bg-linear-to-r from-slate-50 to-emerald-50/40 border border-emerald-200 rounded-2xl">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">
          Butuh Pendampingan atau Konsultasi Spesifik?
        </h2>
        <p class="text-slate-600 leading-relaxed mb-6">
          Diskusikan rencana implementasi atau pertimbangan teknis Anda langsung bersama representatif profesional kami.
        </p>
        <WaButton
          text="Mulai Diskusi via WhatsApp"
          message={`Halo, saya membaca artikel "${article.data.title}" dan ingin berkonsultasi lebih lanjut.`}
          class="text-base px-8 py-3.5"
        />
      </div>
    </article>
  </div>

  <WaButton variant="floating" />
</BaseLayout>
