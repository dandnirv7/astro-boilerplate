---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { WaButton } from '../capabilities/lead/index.js';
import { resolveCanonical } from '../lib/seo';
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
  buildBreadcrumbSchema,
} from '../lib/schema';

const pageEntry = await getEntry('pages', 'tentang-kami');
if (!pageEntry) {
  return Astro.redirect('/404');
}

const { Content } = await render(pageEntry);

const canonicalUrl = resolveCanonical('/tentang-kami/');
const pageTitle = `${pageEntry.data.title} & Komitmen Profesional`;
const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: pageEntry.data.title, url: '/tentang-kami/' },
];

const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, pageTitle, pageEntry.data.description, {
    breadcrumbId: `${canonicalUrl}#breadcrumb`,
  }),
  buildBreadcrumbSchema(breadcrumbItems, canonicalUrl),
];
---

<BaseLayout
  title={pageTitle}
  description={pageEntry.data.description}
  canonical={canonicalUrl}
  graph={graph}
>
  <!-- Explicit LEAD composition: header CTA + floating button (opt-in per page) -->
  <Header slot="header">
    <div slot="cta" class="flex items-center gap-4">
      <WaButton text="Konsultasi" variant="inline" class="text-sm px-4 py-2" />
    </div>
  </Header>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <Breadcrumbs items={breadcrumbItems} class="mb-6" />

    <article class="prose prose-slate lg:prose-lg max-w-none">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        {pageEntry.data.title}
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed border-b border-slate-200 pb-6 mb-8">
        {pageEntry.data.description}
      </p>

      <div class="space-y-6 text-slate-700 leading-relaxed">
        <Content />
      </div>
    </article>

    <div class="mt-12 p-8 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-bold text-slate-900">Ingin Berdiskusi Lebih Lanjut?</h2>
        <p class="text-sm text-slate-600 mt-1">Tim kami siap membantu menjawab pertanyaan Anda.</p>
      </div>
      <WaButton text="Hubungi Tim Kami" class="whitespace-nowrap" />
    </div>
  </div>

  <WaButton variant="floating" />
</BaseLayout>
