---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { resolveCanonical } from '../lib/seo';
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
} from '../lib/schema';

const canonicalUrl = resolveCanonical(Astro.url);

// Single JSON-LD @graph for the page (generic Starter: no business entities).
const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, siteConfig.name, siteConfig.description),
];
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
  canonical={canonicalUrl}
  graph={graph}
>
  <section class="relative overflow-hidden bg-linear-to-b from-slate-50 via-white to-white py-20 sm:py-28">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Arsitektur Generik • Static-First • Fondasi SEO</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {siteConfig.name}
      </h1>

      <p class="mt-3 text-lg sm:text-xl font-medium text-emerald-700">
        {siteConfig.tagline}
      </p>

      <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        {siteConfig.description}
      </p>
    </div>
  </section>
</BaseLayout>
