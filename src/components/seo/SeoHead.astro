---
import { siteConfig } from '../../config/site';
import { resolveCanonical, resolveTitle } from '../../lib/seo';
import { absoluteUrl } from '../../lib/schema';
import { getOgImageUrl } from '../../lib/og';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  og?: {
    title?: string;
    description?: string;
    image?: string;
    type?: 'website' | 'article' | 'profile';
  };
  twitter?: {
    card?: 'summary' | 'summary_large_image';
    site?: string;
    creator?: string;
  };
  robots?: {
    index?: boolean;
    follow?: boolean;
    maxSnippet?: number;
    maxImagePreview?: 'none' | 'standard' | 'large';
    noarchive?: boolean;
  };
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    tags?: string[];
  };
}

const {
  title,
  description = siteConfig.description,
  canonical,
  image,
  og = {},
  twitter = {},
  robots = {},
  article,
} = Astro.props;

// Canonical URL (strips tracking parameters)
const pageUrl = Astro.url;
const canonicalUrl = canonical ? resolveCanonical(canonical) : resolveCanonical(pageUrl);

// Titles
const formattedTitle = resolveTitle(title);
const ogTitle = og.title || title || siteConfig.name;
const ogDescription = og.description || description;

// OG Image resolution (1200x630, always absolute: explicit image props may be
// site-relative paths, so resolve them against the production URL).
// Non-indexable pages (404, drafts, private utilities) fall back to the
// default OG image instead of requesting a per-page image that is not generated.
const ogImageUrl = absoluteUrl(
  og.image || image || (robots.index === false ? getOgImageUrl() : getOgImageUrl(Astro.url.pathname))
);

// Robots directives
const isIndex = robots.index ?? true;
const isFollow = robots.follow ?? true;
const maxSnippet = robots.maxSnippet ?? -1;
const maxImagePreview = robots.maxImagePreview ?? 'large';
const robotsDirectives = [
  isIndex ? 'index' : 'noindex',
  isFollow ? 'follow' : 'nofollow',
  `max-snippet:${maxSnippet}`,
  `max-image-preview:${maxImagePreview}`,
  'max-video-preview:-1',
  robots.noarchive ? 'noarchive' : '',
]
  .filter(Boolean)
  .join(', ');
---

<!-- Global Metadata -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="description" content={description} />

<!-- Search Engine Crawler Directives (satu tag, deterministik) -->
<meta name="robots" content={robotsDirectives} />
<meta name="googlebot" content={robotsDirectives} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={og.type || 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogTitle} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />

{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
{article?.authors?.map((author) => <meta property="article:author" content={author} />)}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content={twitter.card || 'summary_large_image'} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImageUrl} />
{twitter.site && <meta name="twitter:site" content={twitter.site} />}
{twitter.creator && <meta name="twitter:creator" content={twitter.creator} />}

<!-- GEO / Agent Discoverability -->
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="help" type="text/plain" href="/llms.txt" />
