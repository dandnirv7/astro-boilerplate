---
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  faqs: FaqItem[];
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  faqs,
  title = 'Pertanyaan yang Sering Diajukan (FAQ)',
  subtitle = 'Jawaban ringkas dan faktual untuk pertanyaan paling umum.',
  class: className = '',
} = Astro.props;
---

<section id="faq" aria-labelledby="faq-heading" class={`py-12 ${className}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <h2 id="faq-heading" class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-3 text-lg text-slate-600">
          {subtitle}
        </p>
      )}
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details
          class="group border border-slate-200 rounded-xl bg-white p-5 transition-colors duration-150 hover:border-slate-300 open:border-emerald-500/40 open:shadow-sm"
        >
          <summary class="flex justify-between items-center font-semibold text-slate-900 cursor-pointer list-none select-none text-base sm:text-lg">
            <span>{faq.question}</span>
            <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-slate-400 group-hover:text-slate-600">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-slate-600 leading-relaxed text-sm sm:text-base border-t border-slate-100 pt-3">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
