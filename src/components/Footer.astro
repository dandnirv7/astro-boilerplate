---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer role="contentinfo" class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      <!-- Col 1: Brand & Bio -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-white tracking-tight">
          <span class="w-8 h-8 rounded-lg bg-emerald-500 text-slate-950 flex items-center justify-center font-black text-lg">Z</span>
          <span>{siteConfig.name}</span>
        </a>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          {siteConfig.description}
        </p>
      </div>

      <!-- Col 2: Navigasi Cepat -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Navigasi</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-emerald-400 transition-colors">Beranda</a></li>
          <li><a href="/articles/" class="hover:text-emerald-400 transition-colors">Artikel & Wawasan</a></li>
          <li><a href="/#faq" class="hover:text-emerald-400 transition-colors">Pertanyaan Umum (FAQ)</a></li>
          <li><a href="/tentang-kami/" class="hover:text-emerald-400 transition-colors">Tentang Kami</a></li>
        </ul>
      </div>

      <!-- Col 3: Kontak & Hubungi -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Kontak</h3>
        <ul class="space-y-2.5 text-sm">
          {siteConfig.contact.email && (
            <li>
              <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-emerald-400 transition-colors">
                {siteConfig.contact.email}
              </a>
            </li>
          )}
          {siteConfig.contact.phone && (
            <li>
              <a href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-emerald-400 transition-colors">
                {siteConfig.contact.phone}
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {currentYear} {siteConfig.name}. Hak Cipta Dilindungi Undang-Undang.</p>
      <div class="flex items-center gap-6">
        <a href="/sitemap-index.xml" class="hover:text-slate-400">Sitemap</a>
        <a href="/llms.txt" class="hover:text-slate-400">LLMs Discovery</a>
      </div>
    </div>
  </div>
</footer>
