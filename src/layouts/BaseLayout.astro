---
import type { Thing } from 'schema-dts';
import { ClientRouter } from 'astro:transitions';
import SeoHead, { type Props as SeoProps } from '../components/seo/SeoHead.astro';
import Schema from '../components/seo/Schema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props extends SeoProps {
  graph?: (Thing | null | undefined)[] | Thing | null;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  graph,
  showHeader = true,
  showFooter = true,
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang="id" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <SeoHead {...seoProps} />
    <Schema graph={graph || null} />
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-white text-slate-900 selection:bg-emerald-100 selection:text-emerald-900">
    <!-- Skip to main content link for a11y -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-emerald-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-white"
    >
      Menuju ke konten utama
    </a>

    {showHeader && (
      <slot name="header">
        <Header />
      </slot>
    )}

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {showFooter && (
      <slot name="footer">
        <Footer />
      </slot>
    )}
  </body>
</html>
